machine:
  files:
    - path: /var/openebs/local/.keep
      op: create
      permissions: 0o755
      content: ""
  install:
    image: ${installer_image}
    disk: ${install_disk}
    wipe: true
  network:
    interfaces:
      - interface: ${network_interface}
        dhcp: true
  nodeLabels:
    topology.kubernetes.io/region: ${cluster_name}
    topology.kubernetes.io/zone: ${node_name}
  kubelet:
    extraArgs:
      rotate-server-certificates: true
    extraMounts:
      - destination: /var/openebs/local
        source: /var/openebs/local
        type: bind
        options:
          - bind
          - rshared
          - rw

---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: ${hostname}
auto: off
